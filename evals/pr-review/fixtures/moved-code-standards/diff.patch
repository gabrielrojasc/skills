diff --git a/watchlists/views/bulk_archive.py b/watchlists/views/bulk_archive.py
new file mode 100644
index 0000000..1536d49
--- /dev/null
+++ b/watchlists/views/bulk_archive.py
@@ -0,0 +1,16 @@
+from rest_framework import status
+from rest_framework.response import Response
+from rest_framework.views import APIView
+
+from watchlists.models import Watchlist
+from watchlists.serializers import BulkArchiveSerializer
+
+
+class WatchlistBulkArchiveView(APIView):
+    def post(self, request):
+        serializer = BulkArchiveSerializer(data=request.data)
+        serializer.is_valid(raise_exception=True)
+        archived = Watchlist.objects.filter(
+            organization=request.user.organization, id__in=serializer.validated_data["ids"]
+        ).update(archived=True)
+        return Response({"archived": archived}, status=status.HTTP_200_OK)
diff --git a/watchlists/views/export.py b/watchlists/views/export.py
new file mode 100644
index 0000000..f2ee819
--- /dev/null
+++ b/watchlists/views/export.py
@@ -0,0 +1,17 @@
+import csv
+
+from django.http import HttpResponse
+from rest_framework.views import APIView
+
+from watchlists.models import Watchlist
+
+
+class WatchlistExportView(APIView):
+    def get(self, request):
+        response = HttpResponse(content_type="text/csv")
+        response["Content-Disposition"] = 'attachment; filename="watchlists.csv"'
+        writer = csv.writer(response)
+        writer.writerow(["id", "name", "archived"])
+        for watchlist in Watchlist.objects.filter(organization=request.user.organization):
+            writer.writerow([watchlist.id, watchlist.name, watchlist.archived])
+        return response
